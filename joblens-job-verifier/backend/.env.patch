# ─────────────────────────────────────────────────────────────────────────────
# .env — ADD THESE LINES to your existing CCPDMS_FINAL/.env
# ─────────────────────────────────────────────────────────────────────────────

# ── Claude AI (Anthropic) ────────────────────────────────────────────────────
# Get your API key from: https://console.anthropic.com
# This is the SAME key shown in your frontend banner (REACT_APP_CLAUDE_API_KEY)
# but used server-side for security.
CLAUDE_API_KEY=sk-ant-api03-YOUR_KEY_HERE

# ── Google Safe Browsing (Optional but recommended) ──────────────────────────
# Get a FREE key from: https://developers.google.com/safe-browsing/v4/get-started
# Enable "Safe Browsing API" in Google Cloud Console → APIs & Services
# If left blank, the system falls back to heuristic-only URL analysis (still works)
GOOGLE_SAFE_BROWSING_API_KEY=AIzaSy-YOUR_KEY_HERE

# ─────────────────────────────────────────────────────────────────────────────
# Your existing .env variables remain UNCHANGED:
# PORT, MONGO_URI, JWT_SECRET, JWT_EXPIRES_IN,
# EMAIL_HOST, EMAIL_PORT, EMAIL_USER, EMAIL_PASS,
# COLLEGE_EMAIL_DOMAIN, MAX_FILE_SIZE_MB, UPLOAD_PATH, APP_URL, NODE_ENV
